# --- database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://iqpm:iqpm@postgres:5432/iqpm

# --- seeding + simulation -----------------------------------------------------
SEED_CSV_PATH=/data/synthetic_timeseries.csv
AI4I_CSV_PATH=/data/ai4i2020.csv
STREAM_AUTOSTART=false
STREAM_INTERVAL_SECONDS=1
STREAM_STEP_SECONDS=30

# --- labels ---------------------------------------------------------------
LABEL_HORIZON_HOURS=24
LABEL_REVEAL_LAG_HOURS=24

# --- training + governance --------------------------------------------------
ROLLING_WINDOW_DAYS=5
MIN_SUPERVISED_ROWS=1000
MIN_F1_FOR_PROMOTION=0.7
AUTOML_TIME_BUDGET_SECONDS=30
ANOMALY_CONTAMINATION=0.02
FAILURE_PROBABILITY_THRESHOLD=0.5
MLFLOW_TRACKING_URI=http://mlflow:5000

# --- drift monitor ----------------------------------------------------------
DRIFT_MONITOR_ENABLED=true
DRIFT_CHECK_INTERVAL_SECONDS=300
DRIFT_WINDOW_HOURS=6
DRIFT_THRESHOLD=12.0

# --- LLM (LangGraph agent) --------------------------------------------------
# Get a free key at https://console.groq.com. Without it the agent still runs
# every tool and governed workflow, but replies with raw JSON instead of
# natural-language explanations.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
